APP_NAME=BizBoard API
ENV=dev
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://bizboard:bizboard@localhost:5432/bizboard
REDIS_URL=redis://localhost:6379/0

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MFA_TOKEN_TTL_MINUTES=10
LOGIN_SESSION_TTL_MINUTES=10
INVITATION_TTL_HOURS=72

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

CORS_ORIGINS=*
MEDIA_ROOT=media
MEDIA_URL=/media
MAX_UPLOAD_MB=20

DEFAULT_LISTING_TTL_DAYS=30
PRIVATE_ACTIVE_LISTING_LIMIT=3
PROMOTIONS_SELF_SERVICE=false

TOTP_ISSUER=BizBoard

LOGIN_START_RATE_LIMIT=10
LOGIN_START_RATE_WINDOW=60
LOGIN_POLL_RATE_LIMIT=60
LOGIN_POLL_RATE_WINDOW=60
COMPLAINT_RATE_LIMIT=5
COMPLAINT_RATE_WINDOW=3600
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW=3600

# Create tables on startup. In production use `alembic upgrade head`.
AUTO_CREATE_TABLES=false